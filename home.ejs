  nav { padding: 0 20px; }
  .nav-links { display: none; }
  .portals-grid { grid-template-columns: 1fr; }
  .softskill-inner { grid-template-columns: 1fr; }
  .features-grid { grid-template-columns: 1fr 1fr; }
  .how-steps { grid-template-columns: 1fr 1fr; gap: 32px; }
  .how-steps::before { display: none; }
  .resume-inner { grid-template-columns: 1fr; padding: 44px 32px; }
  .cta-inner { padding: 52px 28px; }
  footer { padding: 24px 20px; flex-direction: column; gap: 12px; text-align: center; }
}
@media (max-width: 600px) {
