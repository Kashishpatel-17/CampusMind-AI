<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CampusMind AI — Smart Education Platform</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --cream:     #faf8f4;
  --paper:     #f4f1eb;
  --sand:      #e8e2d9;
  --stone:     #c4bdb4;
  --ink:       #1c1916;
  --ink-mid:   #3d3a36;
  --ink-light: #7a736b;
  --teal:      #2a7a6f;
  --teal-light:#3a9b8e;
  --teal-pale: #e4f0ef;
  --amber:     #c8742a;
  --amber-pale:#fdf3e8;
  --slate:     #3a4a5c;
  --slate-pale:#edf1f5;
  --r: 20px;
  --r-lg: 28px;
}

html { scroll-behavior: smooth; }

body {
  font-family: 'Outfit', sans-serif;
  background: var(--cream);
  color: var(--ink);
  overflow-x: hidden;
}

/* ── NOISE TEXTURE OVERLAY ── */
body::before {
  content: '';
  position: fixed; inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E");
  pointer-events: none; z-index: 0; opacity: 0.5;
}

/* ═══ NAV ═══ */
nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 200;
  padding: 0 60px;
  height: 68px;
  display: flex; align-items: center; justify-content: space-between;
  background: rgba(250,248,244,0.88);
  backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--sand);
}
.nav-logo {
  font-family: 'Playfair Display', serif;
  font-size: 21px; font-weight: 700; color: var(--ink);
  letter-spacing: -0.5px;
}
.nav-logo span { color: var(--teal); }
.nav-links {
  display: flex; gap: 36px; list-style: none;
}
.nav-links a {
  font-size: 14px; font-weight: 400; color: var(--ink-light);
  text-decoration: none; letter-spacing: 0.2px;
  transition: color 0.2s;
}
.nav-links a:hover { color: var(--ink); }
.nav-actions { display: flex; gap: 10px; }
.nav-btn {
  padding: 8px 20px; border-radius: 8px; font-size: 13px;
  font-weight: 500; text-decoration: none; font-family: 'Outfit', sans-serif;
  transition: all 0.2s; cursor: pointer; border: none;
}
.nav-btn-ghost {
  background: transparent; color: var(--ink-mid);
  border: 1px solid var(--sand);
}
.nav-btn-ghost:hover { background: var(--paper); border-color: var(--stone); }
.nav-btn-fill {
  background: var(--teal); color: #fff;
  border: 1px solid var(--teal);
}
.nav-btn-fill:hover { background: var(--teal-light); }

/* ═══ HERO ═══ */
.hero {
  position: relative; z-index: 1;
  min-height: 100vh;
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; text-align: center;
  padding: 130px 24px 80px;
  overflow: hidden;
}

/* Decorative circles */
.hero-circle-1 {
  position: absolute; width: 520px; height: 520px; border-radius: 50%;
  border: 1px solid var(--sand); top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  pointer-events: none;
  animation: slowSpin 60s linear infinite;
}
.hero-circle-2 {
  position: absolute; width: 360px; height: 360px; border-radius: 50%;
  border: 1px dashed var(--stone); top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  pointer-events: none;
  animation: slowSpin 40s linear infinite reverse;
}
.hero-dot {
  position: absolute; width: 8px; height: 8px; border-radius: 50%;
  background: var(--teal); opacity: 0.35; pointer-events: none;
}
.hero-dot:nth-child(3)  { top: 22%; left: 18%; animation: floatDot 6s ease-in-out infinite; }
.hero-dot:nth-child(4)  { top: 30%; right: 16%; animation: floatDot 8s ease-in-out infinite 1s; }
.hero-dot:nth-child(5)  { bottom: 25%; left: 22%; animation: floatDot 7s ease-in-out infinite 2s; }
.hero-dot:nth-child(6)  { bottom: 20%; right: 20%; animation: floatDot 9s ease-in-out infinite 0.5s; background: var(--amber); }

@keyframes slowSpin { to { transform: translate(-50%, -50%) rotate(360deg); } }
@keyframes floatDot {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12px); }
}

.hero-eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: 12px; font-weight: 500; letter-spacing: 2px;
  text-transform: uppercase; color: var(--teal);
  background: var(--teal-pale); border-radius: 50px;
  padding: 6px 16px; margin-bottom: 32px;
  animation: fadeUp 0.8s both;
  position: relative; z-index: 1;
}
.eyebrow-dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--teal); animation: pulse 2s infinite;
}
@keyframes pulse { 0%,100%{opacity:1;transform:scale(1);} 50%{opacity:0.5;transform:scale(0.8);} }

.hero h1 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(46px, 7.5vw, 92px);
  font-weight: 700; line-height: 1.04; letter-spacing: -2.5px;
  color: var(--ink); margin-bottom: 12px;
  animation: fadeUp 0.8s 0.1s both;
  position: relative; z-index: 1;
}
.hero h1 em {
  font-style: italic; color: var(--teal);
}
.hero h1 .word-stroke {
  -webkit-text-stroke: 2px var(--ink);
  color: transparent;
}

.hero-rule {
  width: 56px; height: 2px; background: var(--stone);
  margin: 28px auto; border-radius: 2px;
  animation: fadeUp 0.8s 0.2s both;
  position: relative; z-index: 1;
}

.hero-sub {
  font-size: clamp(15px, 1.9vw, 18px); color: var(--ink-light);
  max-width: 520px; line-height: 1.72; margin-bottom: 52px;
  font-weight: 300;
  animation: fadeUp 0.8s 0.25s both;
  position: relative; z-index: 1;
}

.hero-pills {
  display: flex; gap: 10px; justify-content: center; flex-wrap: wrap;
  margin-bottom: 52px;
  animation: fadeUp 0.8s 0.3s both;
  position: relative; z-index: 1;
}
.pill {
  display: flex; align-items: center; gap: 7px;
  padding: 7px 16px; border-radius: 50px; font-size: 13px; font-weight: 400;
  border: 1px solid var(--sand); background: var(--paper);
  color: var(--ink-mid);
}
.pill-icon { font-size: 14px; }

.hero-cta {
  display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;
  animation: fadeUp 0.8s 0.35s both;
  position: relative; z-index: 1;
}
.cta-main {
  display: inline-flex; align-items: center; gap: 10px;
  padding: 14px 32px; border-radius: var(--r); font-size: 15px;
  font-weight: 600; text-decoration: none; font-family: 'Outfit', sans-serif;
  transition: all 0.25s; cursor: pointer; border: none;
  letter-spacing: 0.1px;
}
.cta-student {
  background: var(--teal); color: #fff;
  box-shadow: 0 4px 24px rgba(42,122,111,0.25);
}
.cta-student:hover { background: var(--teal-light); box-shadow: 0 8px 32px rgba(42,122,111,0.35); transform: translateY(-2px); }
.cta-teacher {
  background: var(--paper); color: var(--ink-mid);
  border: 1px solid var(--sand);
}
.cta-teacher:hover { background: var(--sand); transform: translateY(-2px); }

.hero-scroll {
  position: absolute; bottom: 36px; left: 50%; transform: translateX(-50%);
  font-size: 12px; letter-spacing: 1.5px; text-transform: uppercase;
  color: var(--stone); display: flex; flex-direction: column; align-items: center; gap: 8px;
  z-index: 1; animation: fadeUp 0.8s 0.6s both;
}
.scroll-line {
  width: 1px; height: 36px; background: linear-gradient(to bottom, var(--stone), transparent);
  animation: scrollPulse 2s ease-in-out infinite;
}
@keyframes scrollPulse { 0%,100%{opacity:0.4;} 50%{opacity:1;} }

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(28px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ═══ SECTION COMMONS ═══ */
section { position: relative; z-index: 1; }
.section-wrap { max-width: 1040px; margin: 0 auto; padding: 0 32px; }
.section-header { text-align: center; margin-bottom: 60px; }
.s-eyebrow {
  display: inline-block; font-size: 11px; font-weight: 600;
  letter-spacing: 2.5px; text-transform: uppercase; color: var(--teal);
  margin-bottom: 14px;
}
.s-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(28px, 4vw, 42px); font-weight: 700;
  color: var(--ink); letter-spacing: -1px; line-height: 1.15;
}
.s-title em { font-style: italic; color: var(--teal); }
.s-desc {
  margin-top: 14px; font-size: 15px; color: var(--ink-light);
  font-weight: 300; line-height: 1.65; max-width: 480px; margin-left: auto; margin-right: auto;
}

/* ═══ PORTALS ═══ */
.portals-section { padding: 100px 0 80px; }
.portals-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 24px;
}
.portal-card {
  border-radius: var(--r-lg); padding: 44px 40px;
  border: 1px solid var(--sand);
  position: relative; overflow: hidden;
  transition: transform 0.3s, box-shadow 0.3s;
  background: var(--paper);
}
.portal-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 20px 60px rgba(28,25,22,0.09);
}
.portal-card.teacher-card { background: linear-gradient(140deg, #f0f4ff 0%, #e8ecf8 100%); border-color: #d4daf0; }
.portal-card.student-card { background: linear-gradient(140deg, #e8f5f3 0%, #ddf0ec 100%); border-color: #c2ddd9; }

.card-stripe {
  position: absolute; top: 0; left: 0; right: 0; height: 4px; border-radius: var(--r-lg) var(--r-lg) 0 0;
}
.teacher-stripe { background: linear-gradient(90deg, #4a6cf7, #8b5cf6); }
.student-stripe  { background: linear-gradient(90deg, #2a7a6f, #06b6d4); }

.card-icon {
  width: 60px; height: 60px; border-radius: 18px;
  display: flex; align-items: center; justify-content: center;
  font-size: 28px; margin-bottom: 22px;
}
.teacher-card .card-icon { background: rgba(74,108,247,0.12); }
.student-card .card-icon  { background: rgba(42,122,111,0.12); }

.card-title {
  font-family: 'Playfair Display', serif;
  font-size: 24px; font-weight: 700; color: var(--ink);
  margin-bottom: 10px; letter-spacing: -0.5px;
}
.card-desc {
  font-size: 14px; color: var(--ink-light); line-height: 1.65;
  font-weight: 300; margin-bottom: 28px;
}
.card-features { list-style: none; }
.card-features li {
  display: flex; align-items: center; gap: 10px;
  font-size: 13.5px; color: var(--ink-mid); padding: 8px 0;
  border-bottom: 1px solid rgba(28,25,22,0.06);
}
.card-features li:last-child { border-bottom: none; }
.feat-check {
  width: 18px; height: 18px; border-radius: 50%; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 9px; font-weight: 700;
}
.teacher-card .feat-check { background: rgba(74,108,247,0.15); color: #4a6cf7; }
.student-card .feat-check  { background: rgba(42,122,111,0.15); color: var(--teal); }

/* ═══ SOFT SKILL ═══ */
.softskill-section { padding: 80px 0 80px; }
.softskill-inner {
  border-radius: var(--r-lg); overflow: hidden;
  border: 1px solid var(--sand); background: var(--paper);
  display: grid; grid-template-columns: 1fr 1fr;
}
.ss-left {
  padding: 60px 52px;
  background: linear-gradient(145deg, #1c3a36 0%, #2a5a52 100%);
  position: relative; overflow: hidden;
}
.ss-left::before {
  content: '';
  position: absolute; width: 300px; height: 300px; border-radius: 50%;
  border: 1px solid rgba(255,255,255,0.07);
  bottom: -80px; right: -80px; pointer-events: none;
}
.ss-left::after {
  content: '';
  position: absolute; width: 180px; height: 180px; border-radius: 50%;
  border: 1px solid rgba(255,255,255,0.05);
  top: -50px; left: -50px; pointer-events: none;
}
.ss-tag {
  display: inline-flex; align-items: center; gap: 7px;
  background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.15);
  border-radius: 50px; padding: 5px 14px; font-size: 11px;
  font-weight: 500; letter-spacing: 1.5px; text-transform: uppercase;
  color: rgba(255,255,255,0.8); margin-bottom: 24px;
}
.ss-title {
  font-family: 'Playfair Display', serif;
  font-size: 34px; font-weight: 700; color: #fff;
  line-height: 1.18; letter-spacing: -1px; margin-bottom: 16px;
}
.ss-title em { font-style: italic; color: #7de8d8; }
.ss-desc {
  font-size: 14.5px; color: rgba(255,255,255,0.65); line-height: 1.7;
  font-weight: 300; margin-bottom: 36px;
}
.ss-metrics {
  display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 36px;
}
.ss-metric {
  background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.1);
  border-radius: 14px; padding: 16px;
}
.ss-metric-val {
  font-family: 'Playfair Display', serif;
  font-size: 28px; font-weight: 700; color: #7de8d8;
  line-height: 1; margin-bottom: 4px;
}
.ss-metric-name { font-size: 11px; color: rgba(255,255,255,0.55); font-weight: 400; letter-spacing: 0.3px; }
.ss-cta {
  display: inline-flex; align-items: center; gap: 8px;
  background: #fff; color: var(--teal);
  padding: 12px 26px; border-radius: var(--r); font-size: 14px;
  font-weight: 600; text-decoration: none; transition: all 0.25s;
}
.ss-cta:hover { background: var(--teal-pale); transform: translateX(4px); }
.ss-cta-arrow { transition: transform 0.25s; }
.ss-cta:hover .ss-cta-arrow { transform: translateX(4px); }

.ss-right { padding: 52px 48px; background: #fff; }
.ss-right-title {
  font-family: 'Playfair Display', serif;
  font-size: 20px; font-weight: 600; color: var(--ink);
  margin-bottom: 28px; letter-spacing: -0.4px;
}
.skill-rows { display: flex; flex-direction: column; gap: 18px; }
.skill-head {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 7px;
}
.skill-name { font-size: 13px; font-weight: 500; color: var(--ink-mid); }
.skill-pct  { font-size: 12px; color: var(--ink-light); }
.skill-bar-bg {
  height: 6px; background: var(--paper); border-radius: 3px; overflow: hidden;
}
.skill-bar-fill {
  height: 100%; border-radius: 3px;
  background: linear-gradient(90deg, var(--teal), #34d399);
  transition: width 1.2s ease;
}
.skill-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 28px; }
.skill-tag {
  padding: 5px 13px; border-radius: 50px; font-size: 12px; font-weight: 400;
  background: var(--teal-pale); color: var(--teal); border: 1px solid rgba(42,122,111,0.2);
}

/* ═══ FEATURES ═══ */
.features-section { padding: 80px 0; }
.features-grid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px;
}
.feat-card {
  background: var(--paper); border: 1px solid var(--sand);
  border-radius: var(--r); padding: 32px 28px;
  transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
  position: relative; overflow: hidden;
}
.feat-card::after {
  content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 3px;
  border-radius: 0 0 var(--r) var(--r);
  background: linear-gradient(90deg, var(--teal), #34d399);
  transform: scaleX(0); transform-origin: left; transition: transform 0.3s;
}
.feat-card:hover { transform: translateY(-4px); box-shadow: 0 12px 40px rgba(28,25,22,0.08); border-color: var(--stone); }
.feat-card:hover::after { transform: scaleX(1); }
.feat-icon {
  width: 44px; height: 44px; border-radius: 12px;
  display: flex; align-items: center; justify-content: center;
  font-size: 20px; margin-bottom: 18px;
  background: var(--cream);
}
.feat-name {
  font-family: 'Playfair Display', serif;
  font-size: 17px; font-weight: 600; color: var(--ink);
  margin-bottom: 9px; letter-spacing: -0.3px;
}
.feat-text { font-size: 13.5px; color: var(--ink-light); line-height: 1.65; font-weight: 300; }

/* ═══ HOW IT WORKS ═══ */
.how-section { padding: 80px 0; background: var(--paper); }
.how-steps {
  display: grid; grid-template-columns: repeat(4, 1fr);
  gap: 0; position: relative;
}
.how-steps::before {
  content: ''; position: absolute; top: 28px; left: 14%; right: 14%; height: 1px;
  background: var(--sand); z-index: 0;
}
.how-step { text-align: center; padding: 0 16px; position: relative; z-index: 1; }
.step-num {
  width: 56px; height: 56px; border-radius: 50%;
  border: 1.5px solid var(--sand); background: var(--cream);
  display: flex; align-items: center; justify-content: center;
  font-family: 'Playfair Display', serif; font-size: 20px; font-weight: 600;
  color: var(--teal); margin: 0 auto 18px;
  transition: all 0.25s;
}
.how-step:hover .step-num {
  background: var(--teal); color: #fff; border-color: var(--teal);
  box-shadow: 0 6px 20px rgba(42,122,111,0.3);
}
.step-name { font-size: 15px; font-weight: 500; color: var(--ink); margin-bottom: 6px; }
.step-desc { font-size: 13px; color: var(--ink-light); line-height: 1.6; font-weight: 300; }

/* ═══ RESUME ANALYZER ═══ */
.resume-section { padding: 80px 0; }
.resume-inner {
  border-radius: var(--r-lg); background: linear-gradient(135deg, #fdf8f0 0%, #fef3e2 100%);
  border: 1px solid #e8d8c0; padding: 64px 60px;
  display: grid; grid-template-columns: 1.1fr 1fr; gap: 60px; align-items: center;
}
.resume-tag {
  display: inline-flex; align-items: center; gap: 7px;
  background: var(--amber-pale); border: 1px solid rgba(200,116,42,0.2);
  border-radius: 50px; padding: 5px 14px; font-size: 11px;
  font-weight: 500; letter-spacing: 1.5px; text-transform: uppercase;
  color: var(--amber); margin-bottom: 22px;
}
.resume-title {
  font-family: 'Playfair Display', serif;
  font-size: 36px; font-weight: 700; color: var(--ink);
  line-height: 1.16; letter-spacing: -1px; margin-bottom: 16px;
}
.resume-title em { font-style: italic; color: var(--amber); }
.resume-desc {
  font-size: 15px; color: var(--ink-light); line-height: 1.7;
  font-weight: 300; margin-bottom: 30px;
}
.resume-bullets { list-style: none; margin-bottom: 36px; }
.resume-bullets li {
  display: flex; align-items: flex-start; gap: 10px;
  font-size: 14px; color: var(--ink-mid); padding: 7px 0;
  border-bottom: 1px solid rgba(200,116,42,0.1);
}
.resume-bullets li:last-child { border-bottom: none; }
.rb-dot {
  width: 7px; height: 7px; border-radius: 50%;
  background: var(--amber); flex-shrink: 0; margin-top: 6px;
}
.resume-cta {
  display: inline-flex; align-items: center; gap: 10px;
  background: var(--amber); color: #fff;
  padding: 13px 28px; border-radius: var(--r); font-size: 14px;
  font-weight: 600; text-decoration: none; transition: all 0.25s;
  box-shadow: 0 4px 20px rgba(200,116,42,0.28);
}
.resume-cta:hover { background: #b5651e; transform: translateY(-2px); box-shadow: 0 8px 28px rgba(200,116,42,0.36); }

.ats-card {
  background: #fff; border: 1px solid #e8d8c0; border-radius: var(--r);
  padding: 28px; box-shadow: 0 8px 32px rgba(28,25,22,0.07);
}
.ats-card-head {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 22px;
}
.ats-label { font-size: 12px; font-weight: 500; color: var(--ink-light); letter-spacing: 0.5px; }
.ats-score-badge {
  width: 68px; height: 68px; border-radius: 50%;
  border: 3px solid var(--amber); display: flex; flex-direction: column;
  align-items: center; justify-content: center;
}
.ats-score-num {
  font-family: 'Playfair Display', serif; font-size: 22px; font-weight: 700; color: var(--amber); line-height: 1;
}
.ats-score-sub { font-size: 9px; color: var(--ink-light); }
.ats-skills { margin-bottom: 18px; }
.ats-skill-row { margin-bottom: 12px; }
.ats-skill-head { display: flex; justify-content: space-between; margin-bottom: 5px; }
.ats-skill-name { font-size: 12px; color: var(--ink-mid); }
.ats-skill-pct { font-size: 11px; color: var(--ink-light); }
.ats-bar-bg { height: 5px; background: #f5ede0; border-radius: 3px; overflow: hidden; }
.ats-bar-fill { height: 100%; border-radius: 3px; background: linear-gradient(90deg, var(--amber), #f59e0b); }
.ats-badges { display: flex; flex-wrap: wrap; gap: 6px; }
.ats-badge {
  padding: 3px 10px; border-radius: 50px; font-size: 11px;
}
.ats-matched { background: #e8f5e9; color: #2e7d32; }
.ats-missing { background: #ffebee; color: #c62828; }
.ats-extra   { background: #e8eaf6; color: #3949ab; }

/* ═══ CTA SECTION ═══ */
.cta-section { padding: 80px 0 100px; }
.cta-inner {
  border-radius: var(--r-lg); background: var(--ink);
  padding: 72px 60px; text-align: center; position: relative; overflow: hidden;
}
.cta-inner::before {
  content: ''; position: absolute; inset: 0;
  background: radial-gradient(ellipse 70% 60% at 50% -10%, rgba(42,122,111,0.35), transparent);
  pointer-events: none;
}
.cta-inner::after {
  content: ''; position: absolute; inset: 0;
  background: radial-gradient(ellipse 50% 40% at 80% 110%, rgba(200,116,42,0.18), transparent);
  pointer-events: none;
}
.cta-eyebrow {
  display: inline-block; font-size: 11px; font-weight: 500;
  letter-spacing: 2px; text-transform: uppercase; color: #7de8d8;
  margin-bottom: 18px; position: relative;
}
.cta-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(30px, 4.5vw, 52px); font-weight: 700; color: #fff;
  letter-spacing: -1.5px; line-height: 1.1; margin-bottom: 16px; position: relative;
}
.cta-title em { font-style: italic; color: #7de8d8; }
.cta-sub {
  font-size: 16px; color: rgba(255,255,255,0.55); margin-bottom: 48px;
  font-weight: 300; position: relative;
}
.cta-btns { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; position: relative; }
.cta-btn {
  display: inline-flex; align-items: center; gap: 10px;
  padding: 14px 30px; border-radius: var(--r); font-size: 15px;
  font-weight: 600; text-decoration: none; transition: all 0.25s; font-family: 'Outfit', sans-serif;
}
.cta-btn-student {
  background: var(--teal); color: #fff;
  box-shadow: 0 4px 24px rgba(42,122,111,0.4);
}
.cta-btn-student:hover { background: var(--teal-light); transform: translateY(-2px); }
.cta-btn-teacher {
  background: rgba(255,255,255,0.1); color: #fff;
  border: 1px solid rgba(255,255,255,0.18);
}
.cta-btn-teacher:hover { background: rgba(255,255,255,0.18); transform: translateY(-2px); }
.cta-or { color: rgba(255,255,255,0.3); font-size: 13px; display: flex; align-items: center; }

/* ═══ FOOTER ═══ */
footer {
  position: relative; z-index: 1;
  border-top: 1px solid var(--sand);
  padding: 28px 60px;
  display: flex; align-items: center; justify-content: space-between;
  font-size: 13px; color: var(--ink-light);
  background: var(--paper);
}
.footer-logo {
  font-family: 'Playfair Display', serif; font-size: 16px; font-weight: 600;
  color: var(--ink); letter-spacing: -0.3px;
}
.footer-logo span { color: var(--teal); }
.footer-links { display: flex; gap: 24px; }
.footer-links a { color: var(--ink-light); text-decoration: none; font-size: 13px; transition: color 0.2s; }
.footer-links a:hover { color: var(--ink); }

/* ═══ OBSERVER ANIMATION ═══ */
.reveal {
  opacity: 0; transform: translateY(32px);
  transition: opacity 0.75s ease, transform 0.75s ease;
}
.reveal.visible { opacity: 1; transform: translateY(0); }
.reveal-delay-1 { transition-delay: 0.1s; }
.reveal-delay-2 { transition-delay: 0.2s; }
.reveal-delay-3 { transition-delay: 0.3s; }

/* ═══ RESPONSIVE ═══ */
