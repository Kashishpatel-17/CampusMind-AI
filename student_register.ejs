<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Registration — CampusMind AI</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        :root {
            --bg: #06080f;
            --surface: rgba(255,255,255,0.05);
            --border: rgba(255,255,255,0.08);
            --border-focus: rgba(62,207,142,0.5);
            --text: #f0f2f8;
            --muted: rgba(240,242,248,0.45);
            --green: #3ecf8e;
            --green-dim: rgba(62,207,142,0.12);
            --blue: #4f8ef7;
            --error: #f87171;
            --error-bg: rgba(248,113,113,0.1);
        }
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            display: flex; align-items: center; justify-content: center;
            padding: 32px 24px;
            overflow-x: hidden;
        }
        body::before {
            content: '';
            position: fixed; inset: 0; z-index: 0; pointer-events: none;
            background:
                radial-gradient(ellipse 600px 500px at 10% 20%, rgba(62,207,142,0.07) 0%, transparent 70%),
                radial-gradient(ellipse 500px 400px at 90% 80%, rgba(79,142,247,0.07) 0%, transparent 70%);
        }
        .page-wrap {
            position: relative; z-index: 1;
            display: flex; flex-direction: column; align-items: center;
            width: 100%; max-width: 480px;
        }
        .logo {
            display: flex; align-items: center; gap: 10px;
            margin-bottom: 32px; text-decoration: none;
        }
        .logo-mark {
            width: 38px; height: 38px; border-radius: 10px;
            background: linear-gradient(135deg, #3ecf8e, #4f8ef7);
            display: flex; align-items: center; justify-content: center;
            font-size: 18px;
        }
        .logo-text { font-family: 'Instrument Serif', serif; font-size: 20px; color: var(--text); }

        .card {
            width: 100%;
            background: rgba(255,255,255,0.04);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 40px;
            backdrop-filter: blur(20px);
        }
        .card-header { margin-bottom: 28px; }
        .role-badge {
            display: inline-flex; align-items: center; gap: 6px;
            background: var(--green-dim);
            border: 1px solid rgba(62,207,142,0.25);
            border-radius: 100px; padding: 4px 12px;
            font-size: 12px; font-weight: 600; color: var(--green);
            letter-spacing: 0.5px; margin-bottom: 14px;
        }
        .card-title {
            font-family: 'Instrument Serif', serif;
            font-size: 28px; font-weight: 400; line-height: 1.2; margin-bottom: 6px;
        }
        .card-sub { font-size: 14px; color: var(--muted); }

        .alert {
            background: var(--error-bg);
            border: 1px solid rgba(248,113,113,0.25);
            border-radius: 10px; padding: 12px 16px;
            font-size: 13.5px; color: var(--error);
            margin-bottom: 20px;
            display: flex; align-items: center; gap: 8px;
        }

        /* Two-column grid for some fields */
        .field-row {
            display: grid; grid-template-columns: 1fr 1fr; gap: 14px;
        }
        .field { margin-bottom: 16px; }
        .field label {
            display: block; font-size: 12.5px; font-weight: 600;
            color: var(--muted); margin-bottom: 7px; letter-spacing: 0.3px;
        }
        .field input, .field select {
            width: 100%;
            background: rgba(255,255,255,0.05);
            border: 1px solid var(--border);
            border-radius: 10px; padding: 11px 14px;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 14px; color: var(--text);
            outline: none; appearance: none;
            transition: border-color 0.2s, background 0.2s;
        }
        .field input::placeholder { color: var(--muted); }
        .field input:focus, .field select:focus {
            border-color: var(--border-focus);
            background: rgba(62,207,142,0.05);
        }
        .field select option { background: #1a2035; color: var(--text); }
        .field-hint {
            font-size: 11.5px; color: var(--muted);
            margin-top: 5px;
        }

        /* Divider */
        .section-divider {
            border: none; border-top: 1px solid var(--border);
            margin: 20px 0 18px;
        }
        .section-label {
            font-size: 11px; font-weight: 700;
            letter-spacing: 1.5px; text-transform: uppercase;
            color: var(--muted); margin-bottom: 16px;
        }

        .btn-submit {
            width: 100%;
            background: linear-gradient(135deg, #3ecf8e, #06b6d4);
            border: none; border-radius: 10px; padding: 14px;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 15px; font-weight: 700; color: #fff;
            cursor: pointer; transition: all 0.25s; margin-top: 8px;
            box-shadow: 0 0 30px rgba(62,207,142,0.2);
        }
        .btn-submit:hover { transform: translateY(-2px); box-shadow: 0 0 50px rgba(62,207,142,0.35); }

        .card-footer { margin-top: 22px; text-align: center; }
        .card-footer p { font-size: 13.5px; color: var(--muted); }
        .card-footer a { color: var(--green); text-decoration: none; font-weight: 600; }
        .card-footer a:hover { opacity: 0.75; }

        .portal-switch { margin-top: 24px; text-align: center; font-size: 13px; color: var(--muted); }
        .portal-switch a { color: var(--blue); text-decoration: none; font-weight: 600; }

        @media(max-width: 480px) {
            .field-row { grid-template-columns: 1fr; }
            .card { padding: 28px 20px; }
        }
    </style>
</head>
<body>
<div class="page-wrap">

    <a href="/" class="logo">
        <div class="logo-mark">🧠</div>
        <span class="logo-text">CampusMind AI</span>
    </a>

    <div class="card">
        <div class="card-header">
            <div class="role-badge">🎓 Student Portal</div>
            <h1 class="card-title">Create your account</h1>
            <p class="card-sub">Join your class and start learning</p>
        </div>

        <% if(message){ %>
            <div class="alert">⚠️ <%= message %></div>
        <% } %>

        <form action="/student/register" method="POST">

            <!-- Personal info -->
            <p class="section-label">Personal Information</p>
            <div class="field-row">
                <div class="field">
                    <label>Full Name</label>
                    <input type="text" name="full_name" placeholder="Your full name" required>
                </div>
                <div class="field">
                    <label>Roll Number</label>
                    <input type="text" name="rollno" placeholder="e.g. 22CS001" required>
                </div>
            </div>

            <div class="field">
                <label>Email Address</label>
                <input type="email" name="email" placeholder="your@email.com" required>
            </div>

            <hr class="section-divider">

            <!-- Academic info -->
            <p class="section-label">Academic Details</p>
            <div class="field-row">
                <div class="field">
                    <label>Department</label>
                    <input type="text" name="department" placeholder="e.g. AI&DS, CSE, IT" required>
                    <p class="field-hint">⚠️ Match exactly with your teacher's</p>
                </div>
                <div class="field">
                    <label>Year</label>
                    <select name="year" required>
                        <option value="">Select Year</option>
                        <option>1st Year</option>
                        <option>2nd Year</option>
                        <option>3rd Year</option>
                        <option>4th Year</option>
                    </select>
                </div>
            </div>

            <hr class="section-divider">

            <!-- Password -->
            <p class="section-label">Set Password</p>
            <div class="field-row">
                <div class="field">
                    <label>Password</label>
                    <input type="password" name="password" placeholder="Create password" required>
                </div>
                <div class="field">
                    <label>Confirm Password</label>
                    <input type="password" name="confirm_password" placeholder="Repeat password" required>
                </div>
            </div>

            <button type="submit" class="btn-submit">Create Account →</button>
        </form>

        <div class="card-footer">
            <p>Already registered? <a href="/student/login">Sign in here</a></p>
        </div>
    </div>

    <div class="portal-switch">
        Are you a teacher? <a href="/register">Teacher Registration →</a>
    </div>

</div>
</body>
</html>
