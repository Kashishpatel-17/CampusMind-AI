<!DOCTYPE html>
<html>
<head>
    <title>Marks</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<div class="container py-5">

    <div class="mb-4">
        <a href="/dashboard" class="btn btn-secondary">← Back to Dashboard</a>
    </div>

    <h2 class="text-center mb-4">Marks Management</h2>

    <!-- ADD MARKS -->
    <div class="card shadow p-4 mb-5" style="border-radius:16px;">
        <h4 class="mb-4">Enter Marks</h4>

        <form action="/save-marks" method="POST">

            <div class="mb-3">
                <label class="form-label fw-bold">Select Class</label>
                <select id="classSelect" class="form-select" required onchange="fillFields()">
                    <option value="">-- Select Department / Year / Subject --</option>
                    <% teacherClasses.forEach(cls => { %>
                        <option
                            value="<%= cls.department %>|<%= cls.year %>|<%= cls.subject %>"
                            data-dept="<%= cls.department %>"
                            data-year="<%= cls.year %>"
                            data-subject="<%= cls.subject %>">
                            <%= cls.department %> — Year: <%= cls.year %> — <%= cls.subject %>
                        </option>
                    <% }) %>
                </select>
            </div>

            <input type="hidden" name="department" id="dept_hidden">
            <input type="hidden" name="year"       id="year_hidden">
            <input type="hidden" name="subject"    id="subject_hidden">

            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label">Exam Type</label>
                    <select name="exam_type" class="form-select" required>
                        <option value="Unit Test">Unit Test</option>
                        <option value="Midterm">Midterm</option>
                        <option value="Final Exam">Final Exam</option>
                        <option value="Assignment">Assignment</option>
                        <option value="Practical">Practical</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Total Marks</label>
                    <input type="number" name="total_marks" class="form-control" placeholder="e.g. 100" required>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Date</label>
                    <input type="date" name="date" class="form-control" required>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Total Students</label>
                <input type="number" id="total_students" name="total_students" class="form-control" min="1" required>
            </div>

            <button type="button" onclick="generateRows()" class="btn btn-primary mb-4">Generate Marks Sheet</button>

            <div id="studentRows"></div>

            <button type="submit" class="btn btn-success mt-3">Save Marks</button>
        </form>
    </div>

    <!-- VIEW MARKS -->
    <div class="card shadow p-4" style="border-radius:16px;">
        <h4 class="mb-4">View Marks Records</h4>

        <form action="/marks" method="GET" class="row g-3 mb-4">
            <div class="col-md-3">
                <label class="form-label">Date</label>
                <input type="date" name="date" class="form-control" value="<%= selectedDate %>">
            </div>
            <div class="col-md-3">
                <label class="form-label">Department</label>
                <input type="text" name="department" class="form-control" placeholder="e.g. AI&DS" value="<%= selectedDept %>">
            </div>
            <div class="col-md-3">
                <label class="form-label">Year</label>
                <select name="year" class="form-select">
                    <option value="">All Years</option>
                    <option <%= selectedYear === '1st Year' ? 'selected' : '' %>>1st Year</option>
                    <option <%= selectedYear === '2nd Year' ? 'selected' : '' %>>2nd Year</option>
                    <option <%= selectedYear === '3rd Year' ? 'selected' : '' %>>3rd Year</option>
                    <option <%= selectedYear === '4th Year' ? 'selected' : '' %>>4th Year</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button class="btn btn-dark w-100">Filter</button>
            </div>
        </form>

        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Roll No</th>
                    <th>Student Name</th>
                    <th>Department</th>
                    <th>Year</th>
                    <th>Subject</th>
                    <th>Exam Type</th>
                    <th>Marks</th>
                    <th>Total</th>
                    <th>Grade</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                <% if(marksRecords && marksRecords.length > 0){ %>
                    <% marksRecords.forEach(record => { %>
                        <tr>
                            <td><%= record.rollno || '-' %></td>
                            <td><%= record.student_name || '-' %></td>
                            <td><%= record.department || '-' %></td>
                            <td><%= record.year || '-' %></td>
                            <td><%= record.subject || '-' %></td>
                            <td><%= record.exam_type || '-' %></td>
                            <td><strong><%= record.marks_obtained ?? '-' %></strong></td>
                            <td><%= record.total_marks ?? '-' %></td>
                            <td>
                                <span class="badge <%=
                                    record.grade === 'O' ? 'bg-success' :
                                    record.grade === 'A' ? 'bg-primary' :
                                    record.grade === 'B' ? 'bg-info text-dark' :
                                    record.grade === 'C' ? 'bg-warning text-dark' :
                                    record.grade === 'D' ? 'bg-secondary' : 'bg-danger'
                                %>"><%= record.grade || '-' %></span>
                            </td>
                            <td><%= record.date ? new Date(record.date).toLocaleDateString() : '-' %></td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr><td colspan="10" class="text-center text-muted">No Marks Records Found</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>

</div>

<script>
function fillFields() {
    const sel = document.getElementById('classSelect');
    const opt = sel.options[sel.selectedIndex];
    if (!opt || !opt.value) return;
    document.getElementById('dept_hidden').value    = opt.getAttribute('data-dept');
    document.getElementById('year_hidden').value    = opt.getAttribute('data-year');
    document.getElementById('subject_hidden').value = opt.getAttribute('data-subject');
}

function generateRows() {
    const total = parseInt(document.getElementById('total_students').value) || 0;
    if (total < 1) { alert('Please enter total students first.'); return; }
    let rows = '<div class="table-responsive"><table class="table table-bordered"><thead class="table-light"><tr><th>#</th><th>Roll Number</th><th>Student Name</th><th>Marks Obtained</th></tr></thead><tbody>';
    for (let i = 1; i <= total; i++) {
        rows += `<tr>
            <td>${i}</td>
            <td><input type="text" name="roll_${i}" class="form-control form-control-sm" placeholder="Roll No" required></td>
            <td><input type="text" name="name_${i}" class="form-control form-control-sm" placeholder="Student Name"></td>
            <td><input type="number" name="marks_${i}" class="form-control form-control-sm" placeholder="Marks" required></td>
        </tr>`;
    }
    rows += '</tbody></table></div>';
    document.getElementById('studentRows').innerHTML = rows;
}
</script>

</body>
</html>
