<!DOCTYPE html>
<html>
<head>
    <title>Teacher Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: linear-gradient(135deg,#dfe9f3,#ffffff); min-height:100vh; }
        .welcome-box { background: linear-gradient(135deg,#4facfe,#00f2fe); color:white; border-radius:20px; padding:30px; }
        .feature-card { border:none; border-radius:20px; transition:0.3s; }
        .feature-card:hover { transform:translateY(-5px); }
        .attendance-card { background:linear-gradient(135deg,#667eea,#764ba2); color:white; }
        .marks-card { background:linear-gradient(135deg,#43cea2,#185a9d); color:white; }
        .behavior-card { background:linear-gradient(135deg,#ff9966,#ff5e62); color:white; }
        .class-tag { background:#e8f0fe; color:#1a73e8; border-radius:20px; padding:6px 14px; font-size:13px; font-weight:600; display:inline-flex; align-items:center; gap:8px; margin:4px; }
        .assign-item { border-radius:12px; background:#f8f9fa; padding:14px 18px; margin-bottom:10px; }
    </style>
</head>
<body>
<div class="container py-5">

    <!-- WELCOME -->
    <div class="welcome-box mb-5 d-flex justify-content-between align-items-center flex-wrap shadow">
        <div>
            <h2>Welcome, <%= teacher.full_name %> 👋</h2>
            <p class="mb-0 opacity-75">Teacher Portal</p>
        </div>
        <a href="/logout" class="btn btn-light text-danger fw-bold mt-3 mt-md-0">Logout</a>
    </div>

    <!-- MY CLASSES -->
    <div class="card p-4 shadow mb-5" style="border-radius:20px;">
        <h4 class="mb-3"> My Classes &amp; Subjects</h4>
        <p class="text-muted small mb-3">Add all classes you teach. This will be used for assignments, attendance, marks, and behavior.</p>

        <% if(teacher.classes && teacher.classes.length > 0){ %>
            <div class="mb-4">
                <% teacher.classes.forEach(cls => { %>
                    <span class="class-tag">
                         <%= cls.department %> | Year: <%= cls.year %> | <%= cls.subject %>
                        <form action="/delete-class" method="POST" style="display:inline;margin:0;">
                            <input type="hidden" name="class_id" value="<%= cls.id %>">
                            <button type="submit" style="background:none;border:none;color:#c62828;cursor:pointer;font-size:14px;padding:0;line-height:1;">✕</button>
                        </form>
                    </span>
                <% }) %>
            </div>
        <% } else { %>
            <div class="alert alert-warning py-2">No classes added yet. Add below.</div>
        <% } %>

        <form action="/add-class" method="POST" class="row g-2 mt-1">
            <div class="col-md-4">
                <input type="text" name="department" class="form-control" placeholder="Department (e.g. AI&DS, CSE, IT)" required>
            </div>
            <div class="col-md-3">
                <select name="year" class="form-select" required>
                    <option value="">-- Select Year --</option>
                    <option>1st Year</option>
                    <option>2nd Year</option>
                    <option>3rd Year</option>
                    <option>4th Year</option>
                </select>
            </div>
            <div class="col-md-3">
                <input type="text" name="subject" class="form-control" placeholder="Subject (e.g. ML, DBMS)" required>
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary w-100">+ Add Class</button>
            </div>
        </form>
    </div>

    <!-- FEATURE CARDS -->
    <div class="row mb-5">
        <div class="col-md-4 mb-4">
            <div class="card feature-card attendance-card shadow h-100">
                <div class="card-body text-center p-4">
                    <h3>Attendance</h3>
                    <p class="mt-3">Take class-wise attendance filtered by department &amp; year.</p>
                    <a href="/attendance" class="btn btn-light mt-3 fw-bold">Open</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card feature-card marks-card shadow h-100">
                <div class="card-body text-center p-4">
                    <h3>Marks</h3>
                    <p class="mt-3">Enter student marks by department, year &amp; subject.</p>
                    <a href="/marks" class="btn btn-light mt-3 fw-bold">Open</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card feature-card behavior-card shadow h-100">
                <div class="card-body text-center p-4">
                    <h3>Behavior</h3>
                    <p class="mt-3">Track discipline &amp; behavior by department &amp; year.</p>
                    <a href="/behavior" class="btn btn-light mt-3 fw-bold">Open</a>
                </div>
            </div>
        </div>
    </div>

    <!-- ASSIGNMENTS BUTTON -->
    <div class="text-center mb-5">
        <a href="/assignments" class="btn btn-dark btn-lg px-5">Manage Assignments</a>
    </div>

    <!-- RECENT ASSIGNMENTS -->
    <div class="card p-4 shadow" style="border-radius:20px;">
        <h4 class="mb-4">Recent Assignments</h4>
        <% let safeAssignments = typeof assignments !== 'undefined' ? assignments : []; %>
        <% if(safeAssignments.length > 0){ %>
            <% safeAssignments.forEach(a => { %>
                <div class="assign-item">
                    <strong><%= a.title %></strong>
                    <div class="small text-muted mt-1">
                        Subject: <strong><%= a.subject %></strong> &nbsp;|&nbsp;
                        Dept: <strong><%= a.department %></strong> &nbsp;|&nbsp;
                        Year: <strong><%= a.year %></strong> &nbsp;|&nbsp;
                        Due: <strong><%= a.due_date %></strong>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="alert alert-info mb-0">No assignments yet.</div>
        <% } %>
    </div>

</div>
</body>
</html>
