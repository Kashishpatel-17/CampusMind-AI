// ============================================================
// FILE HANDLING
// ============================================================
let resumeFile = null;
let resumeText = '';

const uploadArea = document.getElementById('uploadArea');
uploadArea.addEventListener('dragover', e => { e.preventDefault(); uploadArea.classList.add('drag-over'); });
uploadArea.addEventListener('dragleave', () => uploadArea.classList.remove('drag-over'));
uploadArea.addEventListener('drop', e => {
    e.preventDefault();
    uploadArea.classList.remove('drag-over');
    const file = e.dataTransfer.files[0];
    if (file) processFile(file);
});

function handleFile(input) {
    if (input.files[0]) processFile(input.files[0]);
}

function processFile(file) {
    const ext = file.name.split('.').pop().toLowerCase();
    if (!['pdf','docx','doc'].includes(ext)) {
        alert('Please upload a PDF or DOCX file.');
        return;
    }
    resumeFile = file;
    document.getElementById('uploadText').textContent = file.name;
    document.getElementById('uploadArea').classList.add('file-selected');
    document.getElementById('fileName').textContent = file.name;
    document.getElementById('fileSize').textContent = `${ext.toUpperCase()} • ${(file.size/1024).toFixed(1)} KB`;
    document.getElementById('fileIcon').textContent = ext === 'pdf' ? '📄' : '📝';
    document.getElementById('fileInfo').style.display = 'block';

    // Read file text using FileReader
    const reader = new FileReader();
    reader.onload = function(e) {
        // For text extraction from PDF/DOCX in browser, we use the raw text
        // PDF text will be extracted as much as possible
        resumeText = e.target.result || '';
    };
    reader.readAsText(file, 'UTF-8');
}

function clearFile() {
    resumeFile = null;
    resumeText = '';
    document.getElementById('resumeFile').value = '';
    document.getElementById('uploadText').textContent = 'Click to browse or drag & drop';
    document.getElementById('uploadArea').classList.remove('file-selected');
    document.getElementById('fileInfo').style.display = 'none';
}

// ============================================================
// CORE ANALYSIS FUNCTIONS
// ============================================================

function preprocessText(text) {
    let t = text.toLowerCase()
        .replace(/c\+\+/g,'cplusplus').replace(/c#/g,'csharp')
        .replace(/\.net/g,'dotnet').replace(/ci\/cd/g,'cicd')
        .replace(/node\.js/g,'nodejs').replace(/asp\.net/g,'aspnet')
        .replace(/m&a/g,'mergers and acquisitions')
        .replace(/l&d/g,'learning and development')
        .replace(/b2b/g,'b2b').replace(/b2c/g,'b2c');
    t = t.replace(/[^\w\s]/g,' ');
    const stopwords = new Set(["i","me","my","we","our","you","your","he","she","it","its","they","their",
        "what","which","who","this","that","these","those","am","is","are","was","were","be","been",
        "being","have","has","had","do","does","did","will","would","shall","should","may","might",
        "can","could","a","an","the","and","but","or","nor","for","so","yet","of","at","by","with",
        "about","into","through","during","before","after","to","from","in","out","on","off","over",
        "under","again","then","once","here","there","when","where","why","how","all","each","more",
        "other","some","such","no","any","if","also","must","s","t","don","doesn","won","isn"]);
    return t.split(/\s+/).filter(w => w.length > 1 && !stopwords.has(w));
}

function extractSkills(text) {
    const textLower = text.toLowerCase()
        .replace(/c\+\+/g,'c++').replace(/c#/g,'c#')
        .replace(/\.net/g,'.net').replace(/node\.js/g,'nodejs');
    const found = new Set();
    SKILL_TAXONOMY.forEach(skill => {
        const escaped = skill.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');
        const re = new RegExp('\\b' + escaped + '\\b','i');
        if (re.test(textLower)) found.add(skill);
    });
    return found;
}

function detectDomain(text) {
    const tLower = text.toLowerCase();
    let best = 'General', bestCount = 0;
    for (const [domain, signals] of Object.entries(DOMAIN_SIGNALS)) {
        const count = signals.filter(s => tLower.includes(s)).length;
        if (count > bestCount) { bestCount = count; best = domain; }
    }
    return best;
}

function computeScore(resumeSkills, jdSkills, resumeTokens, jdTokens) {
    const matched = new Set([...resumeSkills].filter(s => jdSkills.has(s)));
    const missing = new Set([...jdSkills].filter(s => !resumeSkills.has(s)));
    const extra   = new Set([...resumeSkills].filter(s => !jdSkills.has(s)));

    const skillScore = jdSkills.size > 0 ? (matched.size / jdSkills.size * 100) : 0;

    const rt = new Set(resumeTokens), jt = new Set(jdTokens);
    const common = [...rt].filter(t => jt.has(t)).length;
    const kwScore = jt.size > 0 ? (common / jt.size * 100) : 0;

    const composite = Math.round(0.70 * skillScore + 0.30 * kwScore * 10) / 10;

    return {
        ats_score: composite,
        skill_score: Math.round(skillScore * 10) / 10,
        keyword_score: Math.round(kwScore * 10) / 10,
        matched_skills: [...matched].sort(),
        missing_skills: [...missing].sort(),
        extra_skills:   [...extra].sort(),
        common_tokens:  common,
        total_jd_tokens: jt.size
    };
}

function generateSuggestions(result, domain, jdText, resumeText) {
    const { ats_score, missing_skills } = result;
    const suggestions = [];

    // Score-based
    if      (ats_score >= 80) suggestions.push(" Excellent match! Mirror the job description's exact phrasing in your bullet points to maximize ATS compatibility.");
    else if (ats_score >= 60) suggestions.push(" Good match. A few targeted additions could push your score above 80%. Add the missing skills you genuinely possess.");
    else if (ats_score >= 40) suggestions.push(" Moderate match. Use the job description's exact terminology throughout your resume for better ATS parsing.");
    else                      suggestions.push(" Low match. Consider upskilling in the missing areas or targeting better-aligned roles.");

    // Missing skills
    if (missing_skills.length > 0) {
        const top = missing_skills.slice(0, 10);
        suggestions.push(`❌ Top Missing Skills: ${top.join(', ')}${missing_skills.length > 10 ? ` (and ${missing_skills.length - 10} more)` : ''}. Add these to your Skills section if you have experience with them.`);
    } else {
        suggestions.push("✅ You have covered all skills mentioned in the job description!");
    }

    // Quantifiable achievements
    if (!/\d+%|\d+ (cr|lakh|million|billion|k|years|months)/i.test(resumeText)) {
        suggestions.push(" Add Quantifiable Achievements. Example: 'Increased sales by 30%' or 'Reduced processing time by 40%' or 'Managed a team of 8 engineers'.");
    }

    // Headings check
    const headings = ['experience','education','skills','projects'];
    const missingHeadings = headings.filter(h => !resumeText.toLowerCase().includes(h));
    if (missingHeadings.length > 0) {
        suggestions.push(`Add clear section headings: ${missingHeadings.map(h => h.charAt(0).toUpperCase()+h.slice(1)).join(', ')}.`);
    }

    // ATS formatting
    suggestions.push(" Formatting Tip: Use simple text formatting. Avoid tables, columns, and graphics — ATS systems may not parse them correctly.");
    suggestions.push(" Use the exact keywords from the job description. ATS engines often match verbatim phrases.");
    suggestions.push(" Keep your resume to 1-2 pages: Summary → Skills → Experience → Education → Projects.");

    // Domain tips
    const tips = DOMAIN_TIPS[domain] || [];
    tips.forEach(tip => suggestions.push("🎯 " + tip));

    return suggestions;
}

// ============================================================
// MAIN ANALYZE FUNCTION
// ============================================================

function analyzeResume() {
    const jdText = document.getElementById('jobDescription').value.trim();

    if (!resumeFile) {
        alert('Please upload your resume first.');
        return;
    }
    if (!jdText) {
        alert('Please paste the job description.');
        return;
    }
    if (!resumeText || resumeText.trim().length < 50) {
        // Try reading again as plain text
        alert('Resume text could not be extracted properly. This analyzer works best with text-based PDFs. If your PDF is scanned/image-based, please use a DOCX file instead, or copy-paste your resume text into the job description field temporarily to test.');
        return;
    }

    document.getElementById('analyzeBtn').disabled = true;
    document.getElementById('analyzingOverlay').style.display = 'block';
    document.getElementById('placeholder').style.display = 'none';
    document.getElementById('scoreBanner').style.display = 'none';
    document.getElementById('resultTabs').style.display = 'none';

    // Small timeout to let UI update
    setTimeout(() => {
        try {
            const domain = detectDomain(jdText);

            const resumeTokens = preprocessText(resumeText);
            const jdTokens     = preprocessText(jdText);
            const resumeSkills = extractSkills(resumeText);
            const jdSkills     = extractSkills(jdText);

            const result = computeScore(resumeSkills, jdSkills, resumeTokens, jdTokens);
            result.suggestions = generateSuggestions(result, domain, jdText, resumeText);

            displayResults(result, domain, resumeText, jdText);

        } catch(err) {
            alert('Analysis error: ' + err.message);
        }

        document.getElementById('analyzeBtn').disabled = false;
        document.getElementById('analyzingOverlay').style.display = 'none';

    }, 800);
}

// ============================================================
// DISPLAY RESULTS
// ============================================================

function displayResults(result, domain, resumeText, jdText) {
    const score = result.ats_score;

    // Score circle color
    let color = '#ef4444'; // red
    if (score >= 75) color = '#10b981';      // green
    else if (score >= 50) color = '#f59e0b'; // amber

    // Animate score circle
    const circle = document.getElementById('scoreCircle');
    circle.style.borderColor = color;
    circle.style.borderTopColor = color;

    document.getElementById('scoreNumber').textContent = score + '%';
    document.getElementById('scoreNumber').style.color = color;

    // Band
    let band = '⚠️ Low Match';
    if      (score >= 80) band = '🏆 Excellent Match!';
    else if (score >= 60) band = '👍 Good Match';
    else if (score >= 40) band = '🤔 Moderate Match';
    document.getElementById('scoreBand').textContent = band;
    document.getElementById('scoreBand').style.color = color;

    document.getElementById('domainBadge').textContent = '🎯 ' + domain;
    document.getElementById('skillBar').style.width = result.skill_score + '%';
    document.getElementById('kwBar').style.width = result.keyword_score + '%';
    document.getElementById('wordCounts').textContent =
        `Skill match: ${result.skill_score}%  |  Keyword match: ${result.keyword_score}%  |  ` +
        `Resume words: ${resumeText.split(/\s+/).length}  |  JD words: ${jdText.split(/\s+/).length}`;

    // Counts
    document.getElementById('matchedCount').textContent = result.matched_skills.length;
    document.getElementById('missingCount').textContent = result.missing_skills.length;

    // Matched skills
    const matchedDiv = document.getElementById('matchedSkills');
    if (result.matched_skills.length > 0) {
        matchedDiv.innerHTML = result.matched_skills.map(s =>
            `<span class="skill-badge skill-matched">✓ ${s}</span>`
        ).join('');
    } else {
        matchedDiv.innerHTML = '<p class="text-muted">No taxonomy skills matched. Add a dedicated Skills section to your resume.</p>';
    }

    // Missing skills
    const missingDiv = document.getElementById('missingSkills');
    if (result.missing_skills.length > 0) {
        missingDiv.innerHTML = result.missing_skills.map(s =>
            `<span class="skill-badge skill-missing">✗ ${s}</span>`
        ).join('');
    } else {
        missingDiv.innerHTML = '<p class="text-success fw-bold">🎯 None — you have covered all skills in the job description!</p>';
    }

    // Suggestions
    const sugDiv = document.getElementById('suggestionsContent');
    sugDiv.innerHTML = result.suggestions.map((s, i) =>
        `<div class="suggestion-item"><strong>${i+1}.</strong> ${s}</div>`
    ).join('');

    // Full report
    document.getElementById('reportContent').textContent =
`══════════════════════════════════════════
  ATS ANALYSIS REPORT — Multi-Domain Edition
══════════════════════════════════════════

  Detected Domain     : ${domain}
  Composite ATS Score : ${result.ats_score}%
  Skill Match Score   : ${result.skill_score}%
  Keyword Match Score : ${result.keyword_score}%

  Resume Words        : ${resumeText.split(/\s+/).length}
  JD Words            : ${jdText.split(/\s+/).length}
  JD Unique Tokens    : ${result.total_jd_tokens}
  Common Tokens       : ${result.common_tokens}
  Taxonomy Size       : ${SKILL_TAXONOMY.size} skills

  Matched Skills (${result.matched_skills.length}):
    ${result.matched_skills.join(', ') || 'none'}

  Missing Skills (${result.missing_skills.length}):
    ${result.missing_skills.join(', ') || 'none'}

  Extra Skills in Resume (${result.extra_skills.length}):
    ${result.extra_skills.join(', ') || 'none'}

══════════════════════════════════════════`;

    // Show results
    document.getElementById('scoreBanner').style.display = 'block';
    document.getElementById('resultTabs').style.display = 'block';
    showTab('suggestions'); // default to suggestions tab
}

// ============================================================
// TAB SWITCHING
// ============================================================

function showTab(tab) {
    ['matched','missing','suggestions','report'].forEach(t => {
        document.getElementById('tab-' + t).style.display = t === tab ? 'block' : 'none';
    });
    document.querySelectorAll('#resultTabList .nav-link').forEach((btn, i) => {
        btn.classList.toggle('active', i === ['matched','missing','suggestions','report'].indexOf(tab));
    });
}
</script>

