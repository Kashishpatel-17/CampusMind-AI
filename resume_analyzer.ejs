const DOMAIN_TIPS = {
    "Technology / Engineering":     ["List your tech stack explicitly: language → framework → database → cloud → tools","Add GitHub link or portfolio URL — many ATS systems scan for these","Mention system scale: 'Built API serving 1M requests/day', 'Reduced latency by 40%'"],
